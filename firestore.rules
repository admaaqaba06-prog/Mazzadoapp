rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /**
     * Administrative access, from ONE record: users/{uid}.
     *
     * This also accepted a hardcoded uid and a hardcoded email address. Both
     * are gone. A literal identity cannot be revoked without a deploy, it
     * outlives whoever held it, and it is legible to anyone who can read the
     * repository — which is precisely what an access-control review asks you
     * not to have.
     *
     * `role` is the canonical field; `isAdmin` is the older mirror of it and
     * both writers (grantAdminRole and the bootstrap script) set the two
     * together. storage.rules reads `role` alone, so DO NOT hand-edit a user
     * document to set only `isAdmin` — that account would pass here and be
     * refused payment proofs in Storage.
     */
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          ('isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
        );
    }

    // S3 — subscription-grant fields are written ONLY by Cloud Functions
    // (requestSubscription / approveSubscription / rejectSubscription via the
    // Admin SDK, which bypasses rules). NO client may write them — including
    // the admin client — so a compromised admin browser session can never
    // hand-craft a grant.
    function touchesSubscriptionGrantFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionStatus', 'subscriptionExpiry', 'subscriptionPlan',
        'subscriptionTier', 'subscriptionApprovedAt', 'subscriptionExpiresAt',
        // Stamped only by the subscriptionExpirySweep (Admin SDK). Nothing gates
        // on it, but it is the audit trail for WHEN a membership lapsed — a
        // client that could rewrite it could make a lapse look recent or undo
        // the record of one entirely.
        'subscriptionExpiredAt'
      ]);
    }

    // Shape of a health row a CLIENT may write. See the system_health match
    // block below for why this is pinned down rather than left open.
    function isClientHealthRow() {
      return request.resource.data.keys().hasOnly([
               'type', 'title', 'details', 'userId', 'userEmail', 'timestamp', 'browser'
             ])
             && request.resource.data.keys().hasAll(['type', 'title', 'details'])
             && request.resource.data.type in ['error', 'payment_fail', 'bid_fail', 'wallet_fail']
             && request.resource.data.title is string
             && request.resource.data.title.size() <= 200
             && request.resource.data.details is string
             && request.resource.data.details.size() <= 4000
             // navigator.userAgent is client-supplied and otherwise unbounded.
             && (!('browser' in request.resource.data)
                 || (request.resource.data.browser is string
                     && request.resource.data.browser.size() <= 500))
             // Attributable to whoever is signed in. 'anonymous' stays allowed
             // because the client falls back to it when the auth session has been
             // restored but the user profile has not loaded yet — which is
             // exactly one of the broken moments this log exists to capture.
             && (!('userId' in request.resource.data)
                 || request.resource.data.userId == request.auth.uid
                 || request.resource.data.userId == 'anonymous');
    }

    // Notification plumbing (CR-02 / CR-03). ALL of it is server-owned:
    // Cloud Functions bypass rules entirely, so these blocks exist to state
    // that no CLIENT may touch them.
    //
    // notifications_log is the send ledger — it is what enforces "never the
    // same auction twice" and the 24h cap. A client that could write it could
    // erase its own cap row and be messaged on every run; one that could
    // delete rows could make the digest resend everything. Admins may read it
    // to answer "why did/didn't this user get a message", and nothing more.
    match /notifications_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per-run summaries (attempted / sent / failed / skipped). Read-only
    // evidence of what each run did, including dry runs.
    match /notificationRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The kill switch. Admin-writable ON PURPOSE — the whole point of
    // `dailyEnabled` / `featuredEnabled` is stopping a send from the console
    // without a redeploy, which is useless if it needs an engineer.
    match /config/notifications {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Nothing else under config/ is client-reachable.
    match /config/{docId} {
      allow read, write: if false;
    }

    // 0.5 Categories — the CR-01 interest taxonomy.
    //
    // World-readable on purpose: the onboarding grid is the first screen after
    // sign-up and the read happens while the auth profile may still be
    // settling, so gating it on isSignedIn() would intermittently blank the
    // grid at exactly the wrong moment. There is nothing private here — these
    // are the same category names already printed on every auction card.
    //
    // Writes are admin-only. The point of the collection is that an admin can
    // add or retire a category without a deploy; letting a client do it would
    // let anyone inject a category that every new user is then asked to pick.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Consent audit trail (CR-01). APPEND-ONLY BY DESIGN.
    //
    // `users/{uid}.notificationConsent` records the current state, but the
    // owner can overwrite their own user doc, so it cannot prove what was
    // agreed to or when. These rows can be created and then never changed or
    // removed by anyone — including the user and including an admin — which is
    // what makes them usable as the record that an opt-in happened before a
    // marketing message went out.
    match /users/{userId}/consentEvents/{eventId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId)
             && request.resource.data.granted is bool
             && request.resource.data.channel in ["whatsapp", "push", "none"];
      allow update, delete: if false;
    }

    // 1. Users block
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          'isAdmin','isBlocked','isVerified','isSeller','wonCount',
          'subscriptionStatus','subscriptionExpiry','subscriptionPlan',
          'subscriptionTier','subscriptionApprovedAt','subscriptionExpiresAt'
        ]) &&
        request.auth.token != null &&
        (
          ('email' in request.auth.token && request.resource.data.email == request.auth.token.email) ||
          ('phone_number' in request.auth.token
            && request.resource.data.phoneNumber == request.auth.token.phone_number
            && (!('email' in request.resource.data) || request.resource.data.email == '' || request.resource.data.email == null))
        ) &&
        // A client may only ever create ITSELF as a plain user. There was an
        // exception here letting one hardcoded address create its own
        // document with role:'admin' — a self-promotion path written into
        // the rules, and the reason the browser could bootstrap its own
        // privilege on sign-in. Admin is granted afterwards, by an
        // administrator, through grantAdminRole.
        request.resource.data.role == 'user';
      allow update: if request.auth != null &&
        // S3 — subscription grants are server-only for EVERY client, admin
        // included (see touchesSubscriptionGrantFields above).
        !touchesSubscriptionGrantFields() && (
        isAdmin() ||
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isAdmin', 'isBlocked', 'isVerified', 'isSeller', 'wonCount',
            // ANTI-SPAM STATE — server-only, for the same reason the flags above
            // are. `placeBid` keeps the bidding rate-limit counters here
            // (functions/bidRateLimit.js) and Cloud Functions bypass rules, so
            // they can still be written by the limiter. Without these two keys
            // the whole limiter is one browser-console call from being reset:
            //   updateDoc(doc(db,'users',myUid), { bidRateLimit: {} })
            // `lastBidAt` is listed for the same reason and closes a hole that
            // pre-dates the limiter — the old inline 1.5s burst guard read it
            // straight off this doc, and was self-resettable the whole time.
            'lastBidAt', 'bidRateLimit'
          ]) &&
          // Owner may CLAIM an email once (empty -> string) but can never CHANGE
          // a non-empty email (it's the receipt/contact identity). "Empty" covers
          // absent/''/null because the phone-signup create rule allows all three.
          // Untouched email (any state, incl. missing key) is checked via
          // affectedKeys so docs without an email field can still self-update.
          //
          // The claimed address used to be checked against the admin email,
          // because client gates read the DOC's email field — which its own
          // owner writes — as an admin credential. No gate does that any
          // more: isAdminUser() in src/utils/adminAuth.ts reads role/isAdmin
          // and nothing else, and no address is privileged in these rules, in
          // storage.rules, in the Cloud Functions or in the client. The
          // special case has nothing left to protect, so it goes with the
          // rest of the literal.
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
            ((!('email' in resource.data) || resource.data.email == '' || resource.data.email == null) &&
              request.resource.data.email is string)
          )
        )
      );
      allow delete: if isAdmin();
    }

    // 2. Auctions block
    match /auctions/{auctionId} {
      allow read: if true;

      // Money- and timing-defining fields. Changing any of these after someone
      // has committed a bid changes the deal under them, so admins lose write
      // access to them at the first bid. Title, media, viewing and approval
      // fields stay editable — LaunchSection edits viewing on LIVE lots.
      function moneyTimingKeys() {
        return [
          'startingPrice', 'currentPrice', 'duration', 'endTime', 'endsAt',
          'scheduledStartAt', 'paymentWindowHours',
          'antiSnipeWindowSec', 'antiSnipeExtendSec'
        ];
      }

      // Reads as zero for missing, null or non-numeric counts, so a malformed
      // doc fails OPEN (editable) rather than locking an admin out of a lot
      // nobody has bid on.
      function auctionBidCount() {
        return resource.data.get('totalBids', 0) is number
          ? resource.data.get('totalBids', 0)
          : 0;
      }

      // Simulated lots are exempt: the admin Simulator's "End now" writes
      // endTime/endsAt from the client on lots its bot has already bid on
      // (SimulatorPanel.tsx). Simulated data is invisible to real users by
      // construction, so no real bidder can be affected.
      // featuredRank is admin-only (enforced by the create/update branches
      // below) and must be a whole number inside the cap. The CAP ITSELF IS NOT
      // ENFORCEABLE HERE — rules cannot count documents, so nothing stops an
      // admin writing rank 1 on seven lots. The feed query's limit(6) bounds
      // that: the failure mode is a confusing admin panel, not a broken feed.
      //
      // The 6 below duplicates FEATURED_CAP in src/utils/featuredRank.ts —
      // rules cannot import TypeScript. Changing the cap means changing BOTH.
      //
      // Passes when the write does not touch featuredRank at all, and when the
      // key is being DELETED (unpin) — `in request.resource.data` is false for a
      // deleted field, so the range check is not reached.
      function featuredRankValid() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featuredRank'])
          || !('featuredRank' in request.resource.data)
          || (request.resource.data.featuredRank is int
              && request.resource.data.featuredRank >= 1
              && request.resource.data.featuredRank <= 6);
      }

      function adminEditBlocked() {
        return auctionBidCount() > 0
          && resource.data.get('isSimulated', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(moneyTimingKeys());
      }

      // Non-admins may only create an under-review auction ('processing' — the standardized
      // pending-review status; legacy 'pending' still accepted) with NO auto-open schedule
      // (still requires admin approval to go live). Only admins can create live/active/upcoming
      // or set scheduledStartAt. Prevents a signed-in user from injecting a live auction
      // directly or one that auto-opens.
      allow create: if isSignedIn() && request.resource.data.createdById == request.auth.uid && (
        isAdmin() ||
        (
          request.resource.data.status in ['processing', 'pending'] &&
          (!('scheduledStartAt' in request.resource.data) || request.resource.data.scheduledStartAt == null) &&
          // Prevent seeding forged bid/winner/approval state that would survive admin approval
          // (fake social-proof wins + inflated bid floor). createListing writes none of these
          // (or writes the safe values checked below); the duplicate flow writes nulls/zeros.
          (!('currentBidderId' in request.resource.data) || request.resource.data.currentBidderId == null) &&
          (!('currentBidderName' in request.resource.data) || request.resource.data.currentBidderName == null) &&
          (!('winnerId' in request.resource.data) || request.resource.data.winnerId == null) &&
          (!('winnerName' in request.resource.data) || request.resource.data.winnerName == null) &&
          (!('winnerEmail' in request.resource.data) || request.resource.data.winnerEmail == null) &&
          (!('winnerPhone' in request.resource.data) || request.resource.data.winnerPhone == null) &&
          (!('totalBids' in request.resource.data) || request.resource.data.totalBids == 0) &&
          // Payment window is a Mazad ops decision: a self-serve seller may only
          // create at the standard 24h. The admin drop builder (isAdmin branch
          // above) can set any preset; a seller can't craft a hostile short
          // window on their own listing that the approving admin never sees.
          (!('paymentWindowHours' in request.resource.data) || request.resource.data.paymentWindowHours == 24) &&
          // Anti-snipe is a Mazad ops decision too: self-serve sellers create at
          // the standard 30s; only the admin drop builder tunes it.
          (!('antiSnipeWindowSec' in request.resource.data) || request.resource.data.antiSnipeWindowSec == 30) &&
          (!('antiSnipeExtendSec' in request.resource.data) || request.resource.data.antiSnipeExtendSec == 30) &&
          // Where an item may be physically viewed is a Mazad ops decision, not a
          // seller's claim to make. Only the admin sets it — at the approval gate
          // or the drop builder (isAdmin branch above) — so a seller may not set
          // these at ANY value: no declaring that buyers may visit them, and
          // certainly not that the lot sits at our office. Approval deliberately
          // writes neither key when no viewing is stated, so a seller-authored
          // claim would otherwise survive the review untouched and go live.
          (!('viewing' in request.resource.data)) &&
          (!('viewingPlace' in request.resource.data)) &&
          // Selling AS MazadJo is Mazad's identity, not a seller's to assume.
          // createListing turns this flag into the buyer-facing sellerName/
          // sellerLogo, so a forged one would let a seller present their own lot
          // as Mazad's own inventory. Only the admin drop builder sets it.
          (!('soldByMazad' in request.resource.data)) &&
          // Featuring is a Mazad merchandising decision, not a seller's to make.
          // Without this a seller could seed featuredRank at creation and the
          // value would survive admin approval straight to the head of the feed.
          (!('featuredRank' in request.resource.data)) &&
          (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false) &&
          (!('approvalStatus' in request.resource.data) || request.resource.data.approvalStatus == 'pending') &&
          (!('currentPrice' in request.resource.data) || request.resource.data.currentPrice == request.resource.data.startingPrice)
        )
      );
      // Non-admin (creator) updates are confined to the REVIEW states: they may
      // edit while under review ('processing'/legacy 'pending') or resubmit a
      // 'rejected' listing back into review — NEVER move a doc to a
      // buyer-visible/terminal status ('upcoming'/'live'/'active'/'completed'),
      // and never touch winner/bidder/price-race, approval-gate or ops-owned
      // fields (forged social-proof wins / self-approval / a self-declared
      // viewing claim). Only isAdmin() — or the Cloud Functions service path,
      // which bypasses rules — may do those.
      // NOT a complete lock, despite what the admin branch below looks like.
      // The CREATOR branch is the remaining gap: it has never listed
      // startingPrice / duration / endTime / endsAt in its denylist, and the
      // drop builder stamps createdById with the admin's own uid
      // (AppContext.tsx createListing), so an admin-created lot that HAS bids
      // still permits editing those four via the creator branch. Reaching it
      // requires an admin to first move the doc to 'processing'/'pending'/
      // 'rejected' (the branch's status gate), which no UI does to a live lot —
      // so it is not reachable by accident, which is what this rule defends
      // against. Left as-is deliberately; closing it means adding those keys to
      // the creator denylist, which would also block the legitimate
      // SellerCenter edit of a rejected listing. Recorded so the next reader
      // does not mistake the admin branch for the whole story.
      allow update: if isSignedIn() && (
        (isAdmin() && !adminEditBlocked() && featuredRankValid()) ||
        (
          resource.data.createdById == request.auth.uid &&
          resource.data.status in ['processing', 'pending', 'rejected'] &&
          request.resource.data.status in ['processing', 'pending', 'rejected'] &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'currentBidderId', 'currentBidderName', 'winnerId', 'winnerName',
            'winnerEmail', 'winnerPhone', 'winnerCity', 'currentPrice',
            'totalBids', 'scheduledStartAt', 'approvalStatus', 'isApproved',
            'approvedAt', 'approvedBy', 'createdById', 'paymentWindowHours',
            'antiSnipeWindowSec', 'antiSnipeExtendSec', 'viewing', 'viewingPlace',
            // Same defence as the create branch: a seller editing their own
            // in-review listing must not be able to feature it.
            'soldByMazad', 'featuredRank'
          ])
        )
      );
      allow delete: if isSignedIn() && (isAdmin() || (resource.data.createdById == request.auth.uid && (resource.data.totalBids == 0 || resource.data.totalBids == null) && resource.data.status == 'upcoming'));
    }

    // Atomic sequence for internal auction numbers. Admin-gated: only the
    // drop builder (admin) reads + increments it in a transaction. Cosmetic
    // value — no money state — so a client transaction is acceptable here.
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Reserve prices (and any future per-auction secrets). NEVER world-readable:
    // auctions/{id} is `allow read: if true`, so the reserve amount must live
    // here, admin-only. Cloud Functions (settleAuctionTxn) bypass rules entirely.
    match /auctionSecrets/{auctionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 3. Bids subcollection (writable ONLY by Cloud Functions)
    match /auctions/{auctionId}/bids/{bidId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Wallets (writable ONLY by Cloud Functions)
    match /wallets/{walletId} {
      allow read: if isSignedIn() && (isOwner(walletId) || isAdmin());
      allow write: if false;
    }

    // 5. Escrow Transactions (writable ONLY by Cloud Functions)
    match /escrows/{escrowId} {
      allow read: if isSignedIn() && (isOwner(resource.data.bidderId) || isOwner(resource.data.sellerId) || isAdmin());
      allow write: if false;
    }

    // 6. Subscription Requests
    match /subscriptionRequests/{reqId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // S3 defense-in-depth: grant-control fields may NEVER be client-set. The
      // real flow (the requestSubscription callable) writes via the Admin SDK
      // and bypasses rules; a direct client create with a forged `tier` (e.g.
      // { price: 1, tier: 'annual' }) — or a price-less `plan: 'annual'` that
      // would ride the resolver's legacy-plan fallback — would otherwise turn
      // a genuine 1 JD proof into a 365-day grant. approveSubscription also
      // cross-checks tier-vs-price server-side; this rule kills the forgery
      // earlier. `plan`'s legacy fallback stays resolver-side for old
      // Admin-SDK-created docs only.
      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    !request.resource.data.keys().hasAny([
                      'tier', 'durationDays', 'approvedTier', 'approvedDurationDays', 'plan'
                    ]);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Chats
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.text is string && 
                    request.resource.data.text.size() > 0 && 
                    request.resource.data.text.size() <= 1000 &&
                    request.resource.data.keys().hasOnly(['id', 'auctionId', 'userId', 'userName', 'userAvatar', 'text', 'timestamp', 'isSystem', 'isBid']);
      allow update, delete: if isAdmin();
    }

    // 8. Site Settings
    match /siteSettings/maintenanceMode {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/featureFlags {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{settingsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 9. System Health Logs
    //
    // Clients DO legitimately create rows here — AppContext logSystemHealth
    // reports client-side error/payment/bid/wallet failures, and those are worth
    // having. But `create: if isSignedIn()` with no validation meant any signed-in
    // user could write arbitrary documents into the admin health log: unbounded
    // payloads, invented `type` values that skew the board's own failure rates,
    // and a forged `source` that would read as though a Cloud Function wrote it.
    // #287 was a lesson in what a health board full of untrustworthy rows costs.
    //
    // So the client-writable shape is pinned: the four types the client actually
    // reports, a bounded key set, size caps, and attribution to the caller.
    // Server rows (source/createdAt, sweep and enforcer types) come in via the
    // Admin SDK, which bypasses rules entirely — and because `hasOnly` forbids
    // `source`, no client can dress a row up as one of them.
    match /system_health/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isClientHealthRow();
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // 9b. System Status (single doc written by pollN8nHealth via Admin SDK;
    // clients only ever read it)
    match /system_status/{statusId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 10. Analytics Events
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 11. Admin Actions
    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 12. Orders
    // Wave 1 — CliQ transaction-reference reservations. One doc per normalized
    // reference, written ONLY by the submitOrderPayment callable (Admin SDK,
    // which bypasses rules) to enforce global uniqueness. No client access.
    match /paymentReferences/{ref} {
      allow read, write: if false;
    }

    // Wave 2 — MZ order-reference reservations. One doc per human-readable ref,
    // written ONLY by assignOrderRef (Admin SDK, which bypasses rules) to
    // enforce global uniqueness. No client access.
    match /orderRefs/{code} {
      allow read, write: if false;
    }

    // Wave 3 — delivery codes. The seller writes this code on the parcel; it
    // must appear in the seller's dispatch photo AND the buyer's receipt photo,
    // and the buyer also types it back to confirm receipt. It is therefore a
    // SECRET FROM THE BUYER — they must learn it from the physical handover,
    // not from the app.
    //
    // It lives in its own document for a reason that is easy to get wrong:
    // Firestore has NO field-level read denylist. `orders/{orderId}` grants the
    // buyer `allow read`, and a granted read returns EVERY field — so a
    // `deliveryCode` key on the order doc would be readable by the one person it
    // must be hidden from, no matter what the update denylist says. Same lesson
    // as Wave 1's paymentReferences and Wave 2's orderRefs.
    //
    // sellerId is denormalized onto this doc so the read rule costs no get().
    // Written ONLY by issueDeliveryCode / releaseOrderEscrow via the Admin SDK,
    // which bypasses rules.
    match /deliveryCodes/{orderId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // The payer's FULL CliQ identifier (bank-registered mobile or alias).
    //
    // Lives here and not on the order for the reason spelled out above
    // `deliveryCodes`: `orders/{orderId}` grants `allow read` to the buyer AND
    // THE SELLER, Firestore has no field-level read denylist, and a granted
    // read returns every field. The cliq* update denylist below stops WRITES
    // and does nothing for reads — so an identifier on the order doc would give
    // the seller the buyer's phone number the moment a request is raised,
    // defeating revealCounterpartyContact's paymentVerified gate.
    //
    // NOT readable by the buyer either: they typed it, their own UI shows the
    // masked copy on the order, and nothing in the app needs to read it back.
    // Admin only, for reconciliation against BAE's settlement reports.
    // Written ONLY by createCliqPaymentRequest via the Admin SDK.
    match /cliqPayerIdentifiers/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The phone the buyer's MANUAL CliQ transfer was sent from.
    //
    // Same leak, same fix as cliqPayerIdentifiers above — this one is older.
    // `cliqSenderPhone` sat on the order doc, which the SELLER can read, so a
    // seller reading the document directly got the buyer's phone number the
    // moment payment was submitted. The admin UI guarded it
    // (`isAdmin && order.cliqSenderPhone`), but a UI guard is not a read rule.
    //
    // Admins need the FULL number to match an incoming transfer, so it is
    // revealed on demand from here rather than masked away entirely.
    // Written ONLY by submitOrderPayment via the Admin SDK.
    match /cliqPaymentSenders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      // S1 — orders are SERVER-CREATED ONLY (settleAuctionTxn /
      // repairEndedAuctionOrder via Admin SDK, which bypasses rules). The doc
      // id is the auction id, so a client-created order would pre-empt the
      // settler's !orderSnap.exists guard and forge the buyer/price.
      allow create: if false;
      // S2 — buyer/seller may update their order, but every financial +
      // identity field is server-only (denylist, because
      // executeOrderTransition writes an open-ended field set).
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid) &&
          // financial + identity fields are server-only
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'buyerId', 'sellerId', 'auctionId', 'winningBidAmount', 'totalDue',
            'buyersPremium', 'escrowId', 'isSimulated', 'createdAt',
            'id', 'buyerName', 'sellerName', 'paymentDeadlineAt', 'paymentWindowHours',
            'paymentVerified', 'paymentVerifiedBy', 'paymentVerifiedAt',
            'paymentRejectionReason', 'paymentRejectedBy', 'paymentRejectedAt',
            'lastNudgedAt', 'nudgeCount',
            // Wave 1 — payment submission is SERVER-ONLY via the
            // submitOrderPayment callable (Admin SDK), which reserves a unique
            // CliQ transaction reference in the same transaction. paymentStatus
            // and every payment-proof field are denylisted here so a client
            // cannot bypass the reference-uniqueness check by writing
            // proof/paid directly. (Was: buyer could self-claim unpaid->paid.)
            'paymentStatus', 'paymentProofUrl', 'cliqSenderPhone', 'cliqSenderPhoneMasked',
            'txnRef', 'txnRefNormalized', 'paymentAttempts', 'paymentSubmittedAt',
            // Embedded CliQ (Bank al Etihad / Staq) — SERVER-ONLY, every field.
            // Two separate holes close here, and both are things BAE tests:
            //   1. `cliqPaymentStatus` is the paid flag. A buyer who could
            //      write it would mark their own gateway payment received.
            //   2. `cliqRequestCreatedAt` / `cliqRequestExpiresAt` ARE the
            //      90-minute duplicate lock. A buyer who could move the expiry
            //      could mint unlimited concurrent requests — the lock is only
            //      as strong as the immutability of the timestamp it reads.
            // `cliqPayerIdentifier` is the payer's banking handle and is
            // written once, by the callable, from a normalized value.
            'cliqPaymentStatus', 'cliqRequestId', 'cliqRequestCreatedAt',
            'cliqRequestExpiresAt', 'cliqPayerIdentifierType', 'cliqPayerIdentifierMasked',
            'cliqPayerIbanPrefix', 'cliqAmount', 'cliqFees', 'cliqTotal',
            'cliqSettledAt', 'paymentMethod', 'cliqRequestAttempts',
            'cliqPaidOutOfBand', 'cliqPaidOutOfBandStatus',
            'cliqSupersededPaid', 'cliqSupersededPaidRequestId', 'cliqSupersededPaidAt',
            // Ownership of chasing an order is a Mazad ops decision — a seller
            // must not be able to reassign it away from the team member
            // accountable for it, or clear it so nobody appears responsible.
            'assignedToId', 'assignedToName',
            'resolutionNotes', 'disputeResolvedBy', 'disputeResolvedAt', 'disputeResolutionType',
            // Wave 3 — the buyer's receipt evidence, the delivery stamp and the
            // code-attempt counter are all written by releaseOrderEscrow / the
            // confirm gate (Admin SDK). A client-written receivedPhotoUrl would
            // be the buyer asserting their own proof of delivery on the doc that
            // releases their money, and a client-writable deliveryCodeAttempts
            // would reset the brute-force counter on every guess. `deliveryCode`
            // is listed even though nothing writes it here — it must never
            // become an order field (see the deliveryCodes block above).
            'receivedPhotoUrl', 'deliveredAt', 'deliveryCodeAttempts',
            'deliveryCode', 'deliveryConfirmedBy'
          ]) &&
          // delivery address/phone are the BUYER's to set (given at the pay
          // step) — a seller must never write or alter where the buyer's item
          // ships. Only the buyer may touch these two fields.
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryAddress', 'deliveryPhone']) ||
            resource.data.buyerId == request.auth.uid
          ) &&
          // Wave 3 — evidence gates. Each seller step may only produce its status
          // if the photo that justifies it is on the resulting document. This is
          // the real enforcement of the model: without it, "self-service status
          // transitions" would just be a client that asks nicely.
          //
          // The `preparing_shipment` gate is scoped to writes that SET the
          // status. Without that exemption a legacy order sitting in
          // `preparing_shipment` from before Wave 3 (no prepPhotoUrl) would be
          // frozen — its seller could not open a dispute or write anything else,
          // because every later write would re-demand a photo that was never
          // taken. `out_for_delivery` needs no such exemption: no document has
          // ever held that status, so there is no legacy shape to strand.
          (
            request.resource.data.status != 'preparing_shipment' ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            (request.resource.data.prepPhotoUrl is string && request.resource.data.prepPhotoUrl.size() > 0)
          ) &&
          (
            request.resource.data.status != 'out_for_delivery' ||
            (
              request.resource.data.sentPhotoUrl is string &&
              request.resource.data.sentPhotoUrl.size() > 0 &&
              request.resource.data.deliveryMethod in ['hand', 'courier']
            )
          ) &&
          // Dispatch evidence is the SELLER's claim to make. A buyer who could
          // write sentPhotoUrl could manufacture the seller's half of the
          // evidence chain and then confirm receipt against it — which pays the
          // seller out of an escrow the goods may never have left.
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['prepPhotoUrl', 'sentPhotoUrl', 'deliveryMethod']) ||
            resource.data.sellerId == request.auth.uid
          ) &&
          // keep the existing terminal-transition guard (settlement is server-only).
          // Wave 1 — status:'paid' is also server-only now: the only path to
          // 'paid' is the submitOrderPayment callable, so a client may never set
          // it directly (that was the old buyer self-claim, now removed).
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['escrowStatus', 'status']) ||
            (
              request.resource.data.status != 'completed' &&
              request.resource.data.status != 'paid' &&
              request.resource.data.escrowStatus != 'released' &&
              request.resource.data.status != 'refunded' &&
              request.resource.data.escrowStatus != 'refunded'
            )
          )
        )
      );
      allow delete: if isAdmin();

      match /activity/{activityId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
      }

      // Internal ops notes ("called seller, courier collects Tuesday").
      //
      // DELIBERATELY SEPARATE from /activity above: the buyer and the seller
      // can READ /activity — OrderDetailsView keeps a live onSnapshot on it —
      // and they can read the order doc itself (the `allow read` rule above;
      // its denylist only stops them WRITING fields). So neither of those can
      // hold anything the team means to keep to itself. This subcollection is
      // the internal channel: isAdmin() on read AND write, no counterparty
      // clause. Do not add one.
      match /adminNotes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // 13. Seller Profiles
    match /sellerProfiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 14. Reviews (seller reviews + order reviews)
    // - Buyer-authored docs (incl. buyer_rates_auction) require buyerId == auth.uid.
    // - Admin one-tap buyer trust ratings set buyerId to the RATED buyer, so they
    //   are allowed only for admins and only with direction == 'mazad_rates_buyer'.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        (request.resource.data.buyerId == request.auth.uid &&
          request.resource.data.direction != 'mazad_rates_buyer' &&
          request.resource.data.direction != 'seller_rates_buyer' &&
          request.resource.data.direction != 'buyer_rates_auction') ||
        (isAdmin() && request.resource.data.direction == 'mazad_rates_buyer')
      );
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 15. Seller Verification Requests
    match /sellerVerificationRequests/{reqId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 16. Seller Reports
    match /sellerReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 17. Disputes
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 18. Notifications
    // Create stays cross-user (order events + admin listing verdicts target
    // OTHER users' bells) but is shape/size/type constrained so a signed-in
    // user can't inject arbitrary phishing docs into someone's global bell:
    // only the known key set, bounded title/description strings, and a type
    // from the app's Notification union. userId is deliberately NOT
    // restricted to self — that would break the legit cross-user writes.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'id', 'userId', 'title', 'titleAr', 'titleEn',
          'description', 'descriptionAr', 'descriptionEn',
          'type', 'priority', 'timestamp', 'read', 'auctionId', 'orderId'
        ]) &&
        request.resource.data.userId is string &&
        request.resource.data.title is string && request.resource.data.title.size() <= 300 &&
        (!('titleAr' in request.resource.data) || (request.resource.data.titleAr is string && request.resource.data.titleAr.size() <= 300)) &&
        (!('titleEn' in request.resource.data) || (request.resource.data.titleEn is string && request.resource.data.titleEn.size() <= 300)) &&
        request.resource.data.description is string && request.resource.data.description.size() <= 500 &&
        (!('descriptionAr' in request.resource.data) || (request.resource.data.descriptionAr is string && request.resource.data.descriptionAr.size() <= 500)) &&
        (!('descriptionEn' in request.resource.data) || (request.resource.data.descriptionEn is string && request.resource.data.descriptionEn.size() <= 500)) &&
        request.resource.data.type in ['info', 'outbid', 'win', 'refund', 'verify', 'alert', 'bid', 'loss', 'wallet', 'order', 'subscription', 'admin'];
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 19. Withdrawals (client cannot write directly, must use Cloud Functions)
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 20. Financial Ledger (writable ONLY by Cloud Functions)
    match /ledger/{ledgerId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 21. Financial Audit Logs (writable ONLY by Cloud Functions)
    match /financialAuditLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }

    // 22. WhatsApp OTP records (code hashes + rate-limit state). Touched ONLY
    //     by the requestWhatsappOtp / verifyWhatsappOtp callables via the admin
    //     SDK. No client may ever read (would leak the hash/salt) or write.
    match /whatsappOtps/{id} {
      allow read, write: if false;
    }
  }
}
