rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * Administrative access, from the SAME record firestore.rules reads.
     *
     * This accepted `request.auth.token.admin == true` or a hardcoded email.
     * Nothing ever called setCustomUserClaims, so the claim was never set and
     * the email literal was the only working admin path for Storage — which
     * is why it was kept one deploy longer than the rest, as the fallback
     * that made the role path safe to switch on. The role path is confirmed
     * working, so the fallback goes.
     *
     * A custom claim was considered as the replacement and rejected: it would
     * be a SECOND source of truth alongside users/{uid}.role, the two can
     * diverge (a console edit changes the role and not the claim), and a claim
     * cannot be revoked promptly because it lives in the ID token until it
     * refreshes — up to an hour. For the one action you most want instant, that
     * is the wrong property.
     *
     * Reading Firestore costs a lookup, but every caller reaches this through
     * `isOwner(userId) || isAdmin()`, and rules short-circuit — so an ordinary
     * owner fetching their own receipt never triggers it. It is evaluated for
     * an admin reading someone else's file, or a delete.
     *
     * NOTE: `role` only. firestore.rules also honours the older `isAdmin`
     * mirror; both writers set the two fields together, so do not hand-edit a
     * user document to set just one.
     */
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Payment Proofs (Readable only by owner & admin; writable only by owner)
    match /payment-proofs/{userId}/{fileName} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 10 * 1024 * 1024; // Limit size to 10MB
      allow update, delete: if isAdmin();
    }

    // 1.5. Verification Documents (Readable only by owner & admin; writable only by owner)
    match /verification-documents/{userId}/{fileName} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 10 * 1024 * 1024; // Limit size to 10MB
      allow update, delete: if isAdmin();
    }

    // 1.6. Profile Avatars (public read — a face shows next to every bid, chat,
    // seller card & order; owner-only write, image-only, ≤10MB). Enables the
    // "add a real photo to bid/sell" trust flow.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Video Upload Path (Unified and restricted to 250MB size limit)
    match /auction-videos/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn()
                    && (request.resource.contentType.matches('video/.*')
                        || request.resource.contentType == 'application/octet-stream'
                        || request.resource.contentType == 'application/mp4')
                    && request.resource.size <= 250 * 1024 * 1024; // Expanded 250MB limit for high-quality mobile uploads
      allow delete: if isAdmin();
    }

    // 3. Thumbnails
    match /auction-thumbnails/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn()
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 20 * 1024 * 1024; // Expanded to 20MB
      allow delete: if isAdmin();
    }

    // 4. Return-claim Photos (E6). Buyer uploads 1–6 evidence images when
    // reporting a problem on a shipped order. The authoritative buyer-ownership
    // check lives in the requestReturn callable; the Storage rule gates writes on
    // any authenticated user (image-only, ≤10MB) and lets authenticated users
    // read so seller/admin can review the claim.
    match /returns/{orderId}/{fileName=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // 5. Wave 3 delivery evidence. Three photos per order: the seller's
    // preparation shot, the seller's dispatch shot (delivery code visible) and
    // the buyer's receipt shot (same code visible). Which party may attach which
    // photo is enforced in firestore.rules on the order write and in the confirm
    // callable — NOT here; this rule gates on any authenticated user,
    // image-only, ≤10MB, the same shape as the returns path above and for the
    // same reason: counterparty and admin must all be able to read the chain
    // when a dispute is adjudicated.
    match /delivery-evidence/{orderId}/{fileName=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Standard reject-all fallthrough
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
